# Normalise line endings to LF in the repository on every OS (Windows checkouts stay usable).
* text=auto eol=lf

*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.xlsx binary
