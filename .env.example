# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the signup/profile API routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to hash Israeli ID numbers for signup rate limiting (any long random string).
SIGNUP_RATE_LIMIT_SECRET=

# Public base URL, used in auth email links and Open Graph metadata (e.g. https://app.example.co.il).
NEXT_PUBLIC_SITE_URL=

# // TODO(pre-launch): remove dev email verification bypass
# "true" skips email verification in development only. Must be unset in production.
DEV_SKIP_EMAIL_VERIFICATION=

# Optional, smoke tests only (see e2e/README.md)
# E2E_BASE_URL=
# E2E_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_MANAGER_EMAIL=
# E2E_RECRUITER_EMAIL=
# E2E_EMPLOYEE_EMAIL=
